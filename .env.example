# Local development settings. Copy to .env or export them; nothing in the code
# defaults these, so a deployment never runs on baked-in credentials.

# S3 catalogue: the local PostGIS from docker-compose.yml.
INGESTION_CATALOGUE_DSN=postgresql://incois:incois@127.0.0.1:5433/incois
# Seconds a catalogue connection may take before a request fails.
INGESTION_CATALOGUE_CONNECT_TIMEOUT=5
# Where scientific arrays are stored (local backend).
INGESTION_OBJECT_STORE=data/store
# S3 read backend: catalogue (PostgreSQL + object store) or memory.
S3_QUERY_BACKEND=catalogue

# S5 serving ceilings (protect the service; not browser budgets).
SERVING_MAX_POINTS=500000
SERVING_MAX_CELLS=5000000
SERVING_MAX_MARKERS=2000
